{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm exec vite build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/manus-storage/:path*",
      "destination": "https://vatntech-rcq5n2zm.manus.space/manus-storage/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://vatntech-rcq5n2zm.manus.space/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
